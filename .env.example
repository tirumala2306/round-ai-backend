# ---- Server ----
PORT=8080
DB_PATH=./data/roundsai.db
# MUST be a long random string in production (e.g. openssl rand -hex 32)
AUTH_SECRET=change-me-dev-only
# Admin panel / web origin allowed to call the API (use your real origin in production)
CORS_ORIGIN=*

# ---- AI provider: mock | openai ----
# mock = runs fully offline with deterministic placeholder output (for UI development)
AI_PROVIDER=mock
OPENAI_API_KEY=
# Set the model your organization approved. Check the current OpenAI docs for model names.
OPENAI_MODEL=
# Speech-to-text model (e.g. gpt-transcribe). Required when AI_PROVIDER=openai and using /transcribe or audio intake.
OPENAI_TRANSCRIBE_MODEL=
# Vision / image OCR model. Falls back to OPENAI_MODEL if empty.
OPENAI_VISION_MODEL=

# ---- PubMed (free) ----
# Optional but recommended: free NCBI API key raises the rate limit
NCBI_API_KEY=
NCBI_EMAIL=you@example.com

# ---- Uploads (PHI) ----
# Raw audio/images are processed then discarded unless true (saved under data/uploads/).
RETAIN_RAW_UPLOADS=false
MAX_AUDIO_BYTES=26214400
MAX_IMAGE_BYTES=10485760
MAX_UPLOAD_BODY_BYTES=35000000

# ---- Limits / flags ----
MAX_AI_CALLS_PER_USER_PER_DAY=200
MAX_CONTEXT_FACTS=300
FEATURE_CONSIDERATIONS=false
